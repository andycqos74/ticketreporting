<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to secrets.config (same folder as Web.config) and fill in
  the real token. secrets.config is gitignored, it must never be committed.
  Web.config merges it in via <appSettings file="secrets.config">.
-->
<appSettings>
  <add key="TicketcoApiToken" value="REPLACE_WITH_REAL_TICKETCO_TOKEN" />
</appSettings>
