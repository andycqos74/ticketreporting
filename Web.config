  <system.webServer>

    <httpErrors errorMode="Detailed" />

    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
      </customHeaders>
    </httpProtocol>
    
    
    <rewrite>
      <rules>
        <rule name="HTTP/S to HTTPS Redirect" enabled="true" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{SERVER_PORT_SECURE}" pattern="^0$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" redirectType="Permanent" />
        </rule>

            <rule name="Rewrite entry form">
              <match url="^ballot-entry" />
              <action type="Rewrite" url="ballot_entry.aspx" />
            </rule>

        <rule name="Rewrite walkupadmin">
          <match url="^walkup" />
          <action type="Rewrite" url="admin_walkup.aspx" />
        </rule>

        <rule name="Rewrite root">
          <match url="^$" />
          <action type="Rewrite" url="admin_walkup.aspx" />
        </rule>

        <rule name="Rewrite admin home">
          <match url="^home" />
          <action type="Rewrite" url="default.aspx" />
        </rule>
        
        
      </rules>
    </rewrite>
  </system.webServer>
  
