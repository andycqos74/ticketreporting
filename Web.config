         a file reference: <appSettings file="secrets.config"> with secrets.config
         kept OUT of source control. -->
    <add key="TicketcoApiToken" value="nk6t4EzmDNuB3vAZ1gMy" />

    <!-- Fixture/event currently on the dashboard. Used as the default when the
         poller starts and when dash_control does not supply one. -->
    <add key="TicketcoActiveEventId" value="924084" />

    <!-- Seconds between API polls (minimum enforced in code is 5). -->
    <add key="TicketcoPollSeconds" value="30" />

    <!-- true  = start polling automatically at app startup (no browser needed).
         false = only poll when dash_control.aspx presses Start. -->
    <add key="TicketcoAutoStart" value="false" />
