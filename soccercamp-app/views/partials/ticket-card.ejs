<% var safeId = ticket.TicketID.replace(/[^a-zA-Z0-9_-]/g, ''); %>
<div class="card mb-3">
  <div class="card-body">
    <h4 class="card-title"><%= ticket.PrintName %></h4>
    <p class="card-text">
      <strong>Ticket type:</strong> <%= ticket.TicketType %><br>
      <strong>Event:</strong> <%= ticket.EventName %><br>
      <strong>Reference:</strong> <%= ticket.TicketCoRef %><br>
      <% if (ticket.Email) { %>
        <strong>Email:</strong> <%= ticket.Email %><br>
      <% } %>
      <strong>Collected:</strong>
      <span class="badge <%= ticket.Collected ? 'badge-success' : 'badge-danger' %>">
        <%= ticket.Collected ? 'Yes' : 'No' %>
      </span>
      <% if (ticket.Collected) { %>
        &mdash; <%= new Date(ticket.CollectedDate).toLocaleString('en-GB') %>,
        size <strong><%= ticket.ShirtSize %></strong>
        <% if (ticket.CollectedBy) { %> (by <%= ticket.CollectedBy %>)<% } %>
      <% } %>
    </p>

    <form method="post" action="/collect/mark" class="responsive-form">
      <input type="hidden" name="id" value="<%= ticket.TicketID %>">

      <label class="mr-2" for="shirtSize-<%= safeId %>">Shirt size:</label>
      <select id="shirtSize-<%= safeId %>" name="shirtSize" class="form-control mr-3" required>
        <option value="">Choose...</option>
        <% shirtSizes.forEach(function(size) { %>
          <option value="<%= size %>" <%= ticket.ShirtSize === size ? 'selected' : '' %>><%= size %></option>
        <% }); %>
      </select>

      <label class="mr-2" for="collectedBy-<%= safeId %>">Issued by:</label>
      <input id="collectedBy-<%= safeId %>" name="collectedBy" class="form-control mr-3" placeholder="optional">

      <% if (ticket.Collected) { %>
        <div class="form-check mr-3">
          <input class="form-check-input" type="checkbox" name="override" value="1" id="override-<%= safeId %>">
          <label class="form-check-label" for="override-<%= safeId %>">Override (already collected)</label>
        </div>
      <% } %>

      <button type="submit" class="btn btn-primary">Mark Collected</button>
    </form>

    <% if (ticket.Collected) { %>
      <form method="post" action="/collect/uncollect" class="mt-3"
            onsubmit="return confirm('Remove this collection? Use this only to correct a shirt issued against the wrong ticket.');">
        <input type="hidden" name="id" value="<%= ticket.TicketID %>">
        <button type="submit" class="btn btn-outline-danger btn-sm btn-block-mobile">Delete collection</button>
      </form>
    <% } %>
  </div>
</div>
