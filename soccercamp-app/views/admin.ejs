<%- include('partials/head', { title: 'Sync' }) %>

<h2>Sync from TicketCo</h2>
<p class="text-muted">
  Pulls every season-ticket holder from TicketCo season pass
  <strong><%= seasonPassId %></strong> whose ticket type is
  <strong><%= ticketTypeFilter %></strong>, and adds/refreshes them in the
  shirt-collection list. Existing "Collected" status and shirt size are never
  touched by a sync.
</p>

<form method="post" action="/admin/sync">
  <button type="submit" class="btn btn-primary">Sync Now</button>
</form>

<% if (result) { %>
  <p class="mt-3 font-weight-bold text-success"><%= result %></p>
<% } %>
<% if (error) { %>
  <p class="mt-3 font-weight-bold text-danger"><%= error %></p>
<% } %>

<% if (sample) { %>
  <div class="card mt-3">
    <div class="card-body">
      <h5 class="card-title">Diagnostic: first matched ticket</h5>
      <p class="card-text mb-1"><strong>buyer_email field:</strong> <%= JSON.stringify(sample.buyer_email) %></p>
      <p class="card-text mb-1"><strong>holder_email field:</strong> <%= JSON.stringify(sample.holder_email) %></p>
      <p class="card-text mb-1"><strong>Email stored:</strong> <%= sample.resolvedEmail || '(none - all candidate fields were empty)' %></p>
      <p class="card-text mb-0"><strong>All fields on this item:</strong> <%= sample.keys.join(', ') %></p>
    </div>
  </div>
<% } %>

<%- include('partials/foot') %>
