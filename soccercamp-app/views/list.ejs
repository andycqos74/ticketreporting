<%- include('partials/head', { title: 'Ticket List' }) %>

<h2>Ticket List</h2>

<form method="get" action="/tickets" class="responsive-form mb-3">
  <label class="mr-2" for="filter">Show:</label>
  <select id="filter" name="filter" class="form-control mr-3" onchange="this.form.submit()">
    <option value="all" <%= filter === 'all' ? 'selected' : '' %>>All</option>
    <option value="notcollected" <%= filter === 'notcollected' ? 'selected' : '' %>>Not collected</option>
    <option value="collected" <%= filter === 'collected' ? 'selected' : '' %>>Collected</option>
  </select>

  <label class="mr-2" for="search">Search name/ref:</label>
  <input id="search" name="search" class="form-control mr-2" value="<%= search %>">
  <button type="submit" class="btn btn-secondary">Search</button>
</form>

<p class="text-muted"><%= rows.length %> ticket(s)</p>

<div class="table-responsive">
  <table class="table table-striped table-bordered table-trim-mobile">
    <thead>
      <tr>
        <th>Name</th>
        <th class="col-secondary">Email</th>
        <th class="col-secondary">Ref</th>
        <th class="col-secondary">Ticket Type</th>
        <th class="col-secondary">Issued</th>
        <th>Collected</th>
        <th>Shirt Size</th>
        <th class="col-secondary">Collected At</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(function(row) { %>
        <tr>
          <td>
            <%= row.PrintName %>
            <% if (row.Email) { %>
              <details class="email-reveal d-md-none">
                <summary title="Show email">&#9993;</summary>
                <span class="email-text"><%= row.Email %></span>
              </details>
            <% } %>
          </td>
          <td class="col-secondary"><%= row.Email || '' %></td>
          <td class="col-secondary"><%= row.TicketCoRef %></td>
          <td class="col-secondary"><%= row.TicketType %></td>
          <td class="col-secondary"><%= row.PurchaseDate ? new Date(row.PurchaseDate).toLocaleDateString('en-GB') : '' %></td>
          <td>
            <span class="badge <%= row.Collected ? 'badge-success' : 'badge-danger' %>">
              <%= row.Collected ? 'Yes' : 'No' %>
            </span>
          </td>
          <td><%= row.ShirtSize || '' %></td>
          <td class="col-secondary"><%= row.CollectedDate ? new Date(row.CollectedDate).toLocaleString('en-GB') : '' %></td>
          <td><a class="btn btn-sm btn-primary" href="/collect?id=<%= encodeURIComponent(row.TicketID) %>">Open</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('partials/foot') %>
