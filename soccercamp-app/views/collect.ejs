<%- include('partials/head', { title: 'Collect a Shirt' }) %>

<h2>Collect a Shirt</h2>

<form method="get" action="/collect" class="responsive-form mb-2" id="lookupForm">
  <label class="mr-2" for="id">Ticket ID or reference:</label>
  <input id="id" name="id" class="form-control mr-2" style="min-width: 260px" value="<%= id %>" autofocus>
  <button type="submit" class="btn btn-secondary mr-2">Find</button>
  <button type="button" id="scanBtn" class="btn btn-outline-secondary">Scan QR code</button>
</form>

<div id="qrReaderWrap" style="display:none; max-width: 400px;" class="mb-3">
  <div id="qrReader"></div>
  <button type="button" id="scanStopBtn" class="btn btn-block btn-outline-danger mt-2">Cancel scan</button>
</div>

<% if (notFound) { %>
  <div class="alert alert-warning">No ticket found for "<%= id %>".</div>
<% } %>
<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>
<% if (message) { %>
  <div class="alert alert-success"><%= message %></div>
<% } %>

<% if (ticket) { %>
  <%- include('partials/ticket-card', { ticket: ticket, shirtSizes: shirtSizes }) %>
<% } %>

<% if (linkedTickets && linkedTickets.length) { %>
  <h5 class="mt-2 mb-3">
    <%= linkedTickets.length %> other ticket<%= linkedTickets.length > 1 ? 's' : '' %> on this email
  </h5>
  <% linkedTickets.forEach(function(lt) { %>
    <%- include('partials/ticket-card', { ticket: lt, shirtSizes: shirtSizes }) %>
  <% }); %>
<% } %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html5-qrcode/2.3.8/html5-qrcode.min.js"></script>
<script src="/js/collect.js"></script>

<%- include('partials/foot') %>
