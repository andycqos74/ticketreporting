# Copy to .env and fill in real values. .env is gitignored.

PORT=3000

# MySQL connection - point DB_HOST at the existing MySQL container's name
# (or service name, if it's on the same docker-compose network).
DB_HOST=mysql
DB_PORT=3306
DB_USER=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_NAME=qosfctickets

# TicketCo public API
TICKETCO_API_TOKEN=REPLACE_WITH_REAL_TICKETCO_TOKEN
SEASON_PASS_ID=1127619
TICKET_TYPE_FILTER=Soccer Camps 2026
